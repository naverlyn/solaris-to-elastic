#!/bin/ksh
# Solaris 10 Metric Performance into Elasticsearch

export PATH=/usr/bin:/usr/sbin:/sbin:/usr/local/bin:$PATH
export LC_ALL=C

# set NFS_DIR as desired.
NFS_DIR="/path/to/nfs"
TOP_PROCESSES_COUNT=15
AWK_CMD="/usr/xpg4/bin/awk"

# get timestamp for @timestamp elasticsearch
TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
FILE_TS=$(date -u +%Y%m%d%H%M%S)

# get IP address and hostname (if available)
HOSTNAME=$(hostname)
IP_ADDRESS=$(ifconfig -a | $AWK_CMD '/inet / && !/127\.0\.0\.1/ {print $2; exit}')
[ -z "$IP_ADDRESS" ] && IP_ADDRESS="unknown"

# get memory in bytes
PAGESIZE=$(pagesize)
MEM_TOTAL_BYTES=$(/usr/sbin/prtconf | $AWK_CMD '/Memory size:/ {print $3*1024*1024}')
MEM_FREE_PAGES=$(kstat -p unix:0:system_pages:freemem | $AWK_CMD '{print $2}')
MEM_FREE_BYTES=$(expr $MEM_FREE_PAGES \* $PAGESIZE)
MEM_USED_BYTES=$(expr $MEM_TOTAL_BYTES - $MEM_FREE_BYTES)

# get swap in bytes (if available)
SWAP_LINE=$(swap -s 2>/dev/null)
SWAP_USED_KB=$(echo "$SWAP_LINE" | $AWK_CMD '{print $9}' | tr -d 'k')
SWAP_AVAILABLE_KB=$(echo "$SWAP_LINE" | $AWK_CMD '{print $11}' | tr -d 'k')
[ -z "$SWAP_USED_KB" ] && SWAP_USED_KB=0
[ -z "$SWAP_AVAILABLE_KB" ] && SWAP_AVAILABLE_KB=0
SWAP_USED_BYTES=$(expr $SWAP_USED_KB \* 1024)
SWAP_AVAILABLE_BYTES=$(expr $SWAP_AVAILABLE_KB \* 1024)
SWAP_TOTAL_BYTES=$(expr $SWAP_USED_BYTES \+ $SWAP_AVAILABLE_BYTES)

# get CPU cores
TOTAL_CORES=$(/usr/sbin/psrinfo 2>/dev/null | wc -l | tr -d ' ')
[ -z "$TOTAL_CORES" ] || [ "$TOTAL_CORES" -eq 0 ] && TOTAL_CORES=$(psrinfo 2>/dev/null | wc -l | tr -d ' ')
[ -z "$TOTAL_CORES" ] && TOTAL_CORES=1

# get Load Average (1m, 5m, 15m)
UPTIME_OUT=$(uptime)
LOAD_1m=$(echo "$UPTIME_OUT" | $AWK_CMD '{ val=$(NF-2); sub(/,$/, "", val); gsub(/,/, ".", val); print val }')
LOAD_5m=$(echo "$UPTIME_OUT" | $AWK_CMD '{ val=$(NF-1); sub(/,$/, "", val); gsub(/,/, ".", val); print val }')
LOAD_15m=$(echo "$UPTIME_OUT" | $AWK_CMD '{ val=$NF; sub(/,$/, "", val); gsub(/,/, ".", val); print val }')
[ -z "$LOAD_1m" ] && LOAD_1m=0.00
[ -z "$LOAD_5m" ] && LOAD_5m=0.00
[ -z "$LOAD_15m" ] && LOAD_15m=0.00

VMSTAT_OUT=$(vmstat 1 2 | sed -n '$p')
CPU_US=$(echo "$VMSTAT_OUT" | $AWK_CMD '{printf "%.2f", $(NF-2)/100}')
CPU_SY=$(echo "$VMSTAT_OUT" | $AWK_CMD '{printf "%.2f", $(NF-1)/100}')
CPU_ID=$(echo "$VMSTAT_OUT" | $AWK_CMD '{printf "%.2f", $NF/100}')
CPU_TOTAL=$(echo "$VMSTAT_OUT" | $AWK_CMD '{printf "%.2f", ($(NF-2) + $(NF-1))/100}')


# set .tmp before switch to .json
SYS_TMP="${NFS_DIR}/.solaris_stat_sys_${FILE_TS}.tmp"
SYS_FINAL="${NFS_DIR}/solaris_stat_sys_${FILE_TS}.json"

cat <<EOF > "$SYS_TMP"
{
  "@timestamp": "$TIMESTAMP",
  "ecs": { "version": "8.11.0" },
  "host": {
    "hostname": "$HOSTNAME",
    "name": "$HOSTNAME",
    "ip": ["$IP_ADDRESS"],
    "os": { "family": "solaris", "name": "Solaris", "version": "10" }
  },
  "system": {
    "memory": {
      "total": ${MEM_TOTAL_BYTES:-0},
      "free": ${MEM_FREE_BYTES:-0},
      "used": { "bytes": ${MEM_USED_BYTES:-0} },
      "swap": {
        "total": ${SWAP_TOTAL_BYTES:-0},
        "free": ${SWAP_AVAILABLE_BYTES:-0},
        "used": { "bytes": ${SWAP_USED_BYTES:-0} }
      }
    },
    "cpu": {
      "cores": ${TOTAL_CORES:-1},
      "total": { "pct": $CPU_TOTAL },
      "user": { "pct": $CPU_US },
      "system": { "pct": $CPU_SY },
      "idle": { "pct": $CPU_ID }
    },
    "load": {
      "1": ${LOAD_1m},
      "5": ${LOAD_5m},
      "15": ${LOAD_15m}
    }
  }
}
EOF
mv "$SYS_TMP" "$SYS_FINAL"


# disk mountpoint
df -k | $AWK_CMD -v ts="$TIMESTAMP" -v host="$HOSTNAME" -v ip="$IP_ADDRESS" -v fts="$FILE_TS" -v nfs="$NFS_DIR" '
  BEGIN { count=0 }
  NR>1 {
    if (NF==1) { fs=$1; getline; $0 = fs " " $0; }
    if ($2 == "0" && $3 == "0") next;
    if ($1 == "swap" || $1 == "fd" || $1 == "mnttab") next;
    
    fs = $1; total_kb = $2; used_kb = $3; avail_kb = $4;
    cap = $5; sub(/%/, "", cap); mount = $NF;
    
    tmp_file = nfs "/.solaris_stat_fs_" count "_" fts ".tmp"
    final_file = nfs "/solaris_stat_fs_" count "_" fts ".json"
    
    printf "{\"@timestamp\":\"%s\",\"ecs\":{\"version\":\"8.11.0\"},\"host\":{\"hostname\":\"%s\",\"name\":\"%s\",\"ip\":[\"%s\"],\"os\":{\"family\":\"solaris\",\"name\":\"Solaris\",\"version\":\"10\"}},\"system\":{\"filesystem\":{\"mount_point\":\"%s\",\"device_name\":\"%s\",\"total\":%s,\"used\":{\"bytes\":%s,\"pct\":%.2f},\"free\":%s}}}\n", ts, host, host, ip, mount, fs, total_kb*1024, used_kb*1024, cap/100, avail_kb*1024 > tmp_file
    
    close(tmp_file)
    system("mv " tmp_file " " final_file)
    count++
  }
'

# network I/O
kstat -p -c net 2>/dev/null | $AWK_CMD -v ts="$TIMESTAMP" -v host="$HOSTNAME" -v ip="$IP_ADDRESS" -v fts="$FILE_TS" -v nfs="$NFS_DIR" '
  BEGIN { count=0 }
  {
    split($1, a, ":"); iface = a[3]; stat = a[4];
    if (stat == "rbytes64") { rx64[iface] = $2; ifaces[iface] = 1 }
    else if (stat == "rbytes") { rx32[iface] = $2; ifaces[iface] = 1 }
    else if (stat == "obytes64") { tx64[iface] = $2; ifaces[iface] = 1 }
    else if (stat == "obytes") { tx32[iface] = $2; ifaces[iface] = 1 }
  }
  END {
    for (i in ifaces) {
      if (i == "lo0") continue;
      in_bytes = (i in rx64) ? rx64[i] : (i in rx32 ? rx32[i] : 0);
      out_bytes = (i in tx64) ? tx64[i] : (i in tx32 ? tx32[i] : 0);
      
      tmp_file = nfs "/.solaris_stat_net_" count "_" fts ".tmp"
      final_file = nfs "/solaris_stat_net_" count "_" fts ".json"
      
      printf "{\"@timestamp\":\"%s\",\"ecs\":{\"version\":\"8.11.0\"},\"host\":{\"hostname\":\"%s\",\"name\":\"%s\",\"ip\":[\"%s\"],\"os\":{\"family\":\"solaris\",\"name\":\"Solaris\",\"version\":\"10\"}},\"system\":{\"network\":{\"name\":\"%s\",\"ingress\":{\"bytes\":%s},\"egress\":{\"bytes\":%s}}}}\n", ts, host, host, ip, i, in_bytes, out_bytes > tmp_file
      
      close(tmp_file)
      system("mv " tmp_file " " final_file)
      count++
    }
  }
'

# Disk I/O
iostat -x 1 2 | $AWK_CMD -v ts="$TIMESTAMP" -v host="$HOSTNAME" -v ip="$IP_ADDRESS" -v fts="$FILE_TS" -v nfs="$NFS_DIR" '
  /extended device statistics/ { block++; next }
  block == 2 && NF >= 8 && $1 != "device" {
    dev = $1; rs = $2; ws = $3; krs = $4; kws = $5;
    
    # convert kb to bytes
    read_bytes = krs * 1024; 
    write_bytes = kws * 1024;
    
    tmp_file = nfs "/.solaris_stat_io_" dev "_" fts ".tmp"
    final_file = nfs "/solaris_stat_io_" dev "_" fts ".json"
    
    printf "{\"@timestamp\":\"%s\",\"ecs\":{\"version\":\"8.11.0\"},\"host\":{\"hostname\":\"%s\",\"name\":\"%s\",\"ip\":[\"%s\"],\"os\":{\"family\":\"solaris\",\"name\":\"Solaris\",\"version\":\"10\"}},\"system\":{\"disk\":{\"name\":\"%s\",\"io\":{\"read\":{\"bytes\":%.0f},\"write\":{\"bytes\":%.0f},\"read_ops\":%.2f,\"write_ops\":%.2f}}}}\n", ts, host, host, ip, dev, read_bytes, write_bytes, rs, ws > tmp_file
    
    close(tmp_file)
    system("mv " tmp_file " " final_file)
  }
'

# prstat
PRSTAT_RAW=$(prstat -n "$TOP_PROCESSES_COUNT" 1 1 2>/dev/null)

echo "$PRSTAT_RAW" | $AWK_CMD -v max_proc="$TOP_PROCESSES_COUNT" \
  -v ts="$TIMESTAMP" \
  -v host="$HOSTNAME" \
  -v ip="$IP_ADDRESS" \
  -v fts="$FILE_TS" \
  -v nfs="$NFS_DIR" '
  BEGIN { found=0; count=0 }
  /PID USERNAME/ { found=1; next }
  /ZONEID/ || /Total:/ { found=0 }
  found && NF>=8 && count<max_proc {
    pid = $1; user = $2; size = $3; rss = $4; state = $5;
    cpu_val = $(NF-1); gsub(/%/, "", cpu_val); gsub(/,/, ".", cpu_val); cpu_pct = cpu_val / 100;
    proc_name = $NF;
    
    tmp_file = nfs "/.solaris_stat_proc_" pid "_" fts ".tmp"
    final_file = nfs "/solaris_stat_proc_" pid "_" fts ".json"
    
    printf "{\"@timestamp\":\"%s\",\"ecs\":{\"version\":\"8.11.0\"},\"host\":{\"hostname\":\"%s\",\"name\":\"%s\",\"ip\":[\"%s\"],\"os\":{\"family\":\"solaris\",\"name\":\"Solaris\",\"version\":\"10\"}},\"process\":{\"pid\":%s,\"name\":\"%s\",\"state\":\"%s\",\"cpu\":{\"pct\":%.4f}},\"user\":{\"name\":\"%s\"},\"solaris\":{\"process\":{\"size\":\"%s\",\"rss\":\"%s\"}}}\n", ts, host, host, ip, pid, proc_name, state, cpu_pct, user, size, rss > tmp_file
    
    close(tmp_file)
    system("mv " tmp_file " " final_file)
    
    count++
  }
'
